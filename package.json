{
  "name": "multiplication-racer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multiplication Racer: World Tour - a 3D racing game powered by times tables and multi-step multiplication.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.21",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "three": "^0.170.0"
  },
  "main": "electron/main.cjs",
  "author": "UTX",
  "homepage": "https://github.com/utx/multiplicationracer",
  "build": {
    "appId": "au.com.utx.multiplicationracer",
    "productName": "Multiplication Racer",
    "copyright": "UTX",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "portable": {
      "artifactName": "MultiplicationRacer-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Multiplication Racer",
      "artifactName": "MultiplicationRacer-Setup.exe"
    },
    "linux": {
      "target": "dir"
    }
  }
}
